@startuml bus_architecture
!include _render_profile.puml

title micrOSAL Bus + Signal Layer — Architecture
left to right direction

actor Producer
actor Subscriber
actor Observer

package "Bus / Signal API" {
    component "osal_bus<T, Capacity>" as BUS
    component "osal_signal<T, N, M>" as SIGNAL
    component "osal_signal_premium<T, N, M>" as PREMIUM
}

package "Implemented Runtime" {
    component "bus_backend_generic\ncanonical LCD runtime" as GEN
    component "delegated bus_backend_* tags\n16 tags -> generic" as DEL
    component "bus_backend_zephyr\nhosted-only fallback" as ZEP_HOST
    component "bus_backend_mock\ntest-only premium tag" as MOCK
}

package "Premium Helpers" {
    component "portable observer table" as OBS
    component "publish_zero_copy()\ncopy fallback today" as ZCOPY
    component "route_to()\nstub today" as ROUTE
}

package "Native Zephyr Runtime (OSAL_BACKEND_ZEPHYR)" {
    component "bus_backend_zephyr\ndedicated channel / signal runtime" as ZEP
    component "k_msgq\nchannel and per-subscriber queues" as ZQUEUE
    component "backend-owned observer table\nchecked bounded callback snapshot" as ZOBS
}

package "MicrOSAL Primitives" {
    component "osal_queue_* C ABI" as QABI
    component "osal::mutex" as MUTEX
}

Producer --> BUS : try_send() / send()
Producer --> SIGNAL : publish()
Subscriber --> SIGNAL : subscribe() / receive()
Observer --> PREMIUM : subscribe_observer()

PREMIUM --> SIGNAL : extends API
SIGNAL --> GEN : canonical runtime
SIGNAL --> DEL : delegated tags
SIGNAL --> ZEP_HOST : hosted Zephyr tag
SIGNAL --> ZEP : real Zephyr build
BUS --> GEN : generic / delegated / hosted
BUS --> ZEP : real Zephyr build
GEN --> QABI : queue path
GEN --> MUTEX : slot guard
DEL --> GEN : delegates
ZEP_HOST --> GEN : non-Zephyr builds only
MOCK --> GEN : reuses runtime
PREMIUM --> OBS : portable callbacks
PREMIUM --> ZEP : native observer hooks
PREMIUM --> MOCK : mock observer hooks
PREMIUM --> ZCOPY
PREMIUM --> ROUTE
ZEP --> ZQUEUE : direct k_msgq calls
ZEP --> ZOBS : register / snapshot / dispatch
ZEP --> MUTEX : slot / observer guard

note bottom of ZOBS
    Snapshot under the mutex;
    invoke callbacks after unlocking.
    Native routing and zero-copy remain unsupported.
end note

@enduml
