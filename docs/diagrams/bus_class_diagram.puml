@startuml bus_class_diagram
!include _render_profile.puml

title micrOSAL Bus + Signal Layer — Class Diagram

namespace osal {

    class "osal_bus<T,Capacity,BackendTag>" as Bus << (T,#ADD1B2) template >> {
        +valid() : bool
        +try_send(item : T) : bool
        +send(item : T, ticks : tick_t) : bool
        +try_receive(out : T&) : bool
        +receive(out : T&, ticks : tick_t) : bool
    }

    class "osal_bus<T,Capacity,\nbus_backend_generic>" as BusGeneric {
        -handle_ : queue_handle_t
        -storage_ : uint8_t[Capacity*sizeof(T)]
        -valid_ : bool
    }

    class "osal_bus<T,Capacity,\nbus_backend_zephyr>\n[real Zephyr]" as BusZephyr {
        -queue_ : k_msgq
        -storage_ : uint8_t[Capacity*sizeof(T)]
        -valid_ : bool
    }

    class "osal_bus<T,Capacity,\nbus_backend_zephyr>\n[hosted fallback]" as BusZephyrHosted {
        -impl_ : osal_bus<T,Capacity,bus_backend_generic>
    }

    Bus <|.. BusGeneric
    Bus <|.. BusZephyr
    Bus <|.. BusZephyrHosted

    class "osal_signal<T,N,M,BackendTag>" as Signal << (T,#ADD1B2) template >> {
        +subscribe(out_id : subscriber_id&) : bool
        +unsubscribe(id : subscriber_id) : bool
        +publish(msg : T) : bool
        +try_receive(id : subscriber_id, out : T&) : bool
        +receive(id : subscriber_id, out : T&, ticks) : bool
        +subscriber_count() : size_t
    }

    class "osal_signal<T,N,M,\nbus_backend_generic>" as SignalGeneric {
        -slots_ : subscriber_slot[N]
        -mutex_ : osal::mutex
        -subscriber_count_ : size_t
    }

    class "osal_signal<T,N,M,\nbus_backend_zephyr>\n[real Zephyr]" as SignalZephyr {
        -slots_ : subscriber_slot[N]
        -mutex_ : osal::mutex
        -observers_ : observer_fn[N]
        -observer_count_ : size_t
        -subscriber_count_ : size_t
        +native_subscribe_observer(fn) : bool
        +native_unsubscribe_observer(fn) : bool
        +native_publish_observers(msg) : bool
        +native_observer_count() : size_t
    }

    class "osal_signal<T,N,M,\nbus_backend_zephyr>\n[hosted fallback]" as SignalZephyrHosted {
    }

    class subscriber_slot {
        +generation_ : subscriber_id
        +in_use_ : bool
        +queue_ : osal_bus<T,M,bus_backend_generic>
    }

    class "subscriber_slot (Zephyr)" as ZephyrSubscriberSlot {
        +generation_ : subscriber_id
        +in_use_ : bool
        +queue_ : osal_bus<T,M,bus_backend_zephyr>
    }

    class "osal_signal_premium<T,N,M,BackendTag>" as SignalPremium {
        +subscribe_observer(fn : observer_fn) : bool
        +unsubscribe_observer(fn : observer_fn) : bool
        +publish(msg : T) : bool
        +publish_zero_copy(ptr : T*) : bool
        +route_to(dest : signal_id, msg : T) : bool
        +observer_count() : size_t
        -observers_ : observer_fn[MaxSubscribers]
        -observer_count_ : size_t
    }

    class "osal_signal_capabilities<BackendTag>" as Caps {
        +native_pubsub : bool
        +native_observers : bool
        +native_routing : bool
        +zero_copy : bool
    }

        Signal <|.. SignalGeneric
        Signal <|.. SignalZephyr
        SignalPremium --|> Signal
        SignalZephyrHosted --|> SignalGeneric
        SignalGeneric *-- subscriber_slot
        subscriber_slot *-- BusGeneric
        SignalZephyr *-- ZephyrSubscriberSlot
        ZephyrSubscriberSlot *-- BusZephyr
        BusZephyrHosted *-- BusGeneric : impl_
        SignalPremium ..> SignalZephyr : backend observer hooks
        SignalPremium ..> Caps : constexpr query

        note right of BusZephyr
            Real Zephyr builds use k_msgq directly.
            Hosted tag instantiations use generic storage.
            These are alternative compile-time definitions,
            not runtime backend selection.
            No Zbus dependency.
        end note

        note right of SignalZephyr
            Observer snapshots use checked bounded storage.
            Callbacks run outside the registration mutex.
            native_pubsub and native_observers are true;
            native_routing and zero_copy remain false.
        end note
}

@enduml
